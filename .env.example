# Copy this file to .env for local development. Values below are local-only examples.
DATABASE_URL="mysql://osrs:local-development-only@127.0.0.1:3306/osrs_services"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="osrs"
DATABASE_PASSWORD="local-development-only"
DATABASE_NAME="osrs_services"
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL="true"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_SESSION_COOKIE="osrs_session"
SESSION_TTL_HOURS="168"

# Optional. The seed creates a local Super Admin only when both are provided.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="Local Super Admin"
