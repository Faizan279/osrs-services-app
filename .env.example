# Copy this file to .env for local development. Values below are local-only examples.
DATABASE_URL="mysql://osrs:local-development-only@127.0.0.1:3306/osrs_services"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="osrs"
DATABASE_PASSWORD="local-development-only"
DATABASE_NAME="osrs_services"
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL="true"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_SESSION_COOKIE="osrs_session"
CUSTOMER_SESSION_COOKIE="osrs_customer_session"
SESSION_TTL_HOURS="168"

# Official transparent logo used by the public and internal layouts.
NEXT_PUBLIC_OSRS_SERVICES_LOGO_SRC="/branding/osrs-services-logo.png"
# Optional verified Discord invitation or support URL. Leave blank to use the on-page support section.
NEXT_PUBLIC_DISCORD_URL=""

# Optional. The seed creates a local Super Admin only when both are provided.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="Local Super Admin"
# Existing administrator passwords are preserved unless this is deliberately enabled.
ADMIN_SEED_RESET_PASSWORD="false"

# Server-only public-stat lookup configuration. Never expose these with NEXT_PUBLIC_*.
ELIGIBILITY_HMAC_SECRET="replace-with-a-separate-at-least-32-character-secret"
RSN_PROVIDER_TIMEOUT_MS="4000"
RSN_CACHE_TTL_SECONDS="300"
RSN_NEGATIVE_CACHE_TTL_SECONDS="60"
RSN_RATE_LIMIT_WINDOW_SECONDS="60"
RSN_RATE_LIMIT_COUNT="8"
# Enable only when the deployment proxy overwrites X-Real-IP from the trusted connection.
RSN_TRUST_PROXY_IP_HEADER="false"
# Local screenshots/tests only. Never enable on a deployed environment.
RSN_DEVELOPMENT_FIXTURE="false"

# Optional private root for Custom Account Build attachments. Keep outside public/.
CUSTOM_BUILD_PRIVATE_ATTACHMENT_ROOT="storage/private/custom-build-attachments"

# Task 005/006 calculator availability is controlled by database FeatureFlag
# rows, not env secrets:
# - "skilling_calculator_enabled"
# - "bossing_calculator_enabled"
# - "premium_configurator_enabled"
# - "global_pricing_enabled"
# - "gold_engine_enabled"
# - "account_marketplace_enabled"
# - "custom_account_build_enabled"
# - "product_marketplace_enabled"
# - "cart_enabled"
# - "guest_checkout_enabled"
# - "customer_accounts_enabled"
# - "customer_registration_enabled"
# - "customer_dashboard_enabled"

# Task 013 checkout and Task 014 customer accounts are manual-review and
# in-app/outbox only. Do not add live payment provider, card, bank, wallet,
# email-delivery, OAuth, SMS or credential secrets until a later approved
# integration task defines them.
