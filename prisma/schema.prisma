generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
  engineType   = "client"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CatalogueServiceType {
  SERVICE
  PRODUCT
  MARKETPLACE
}

enum CatalogueEngineType {
  CATALOGUE_CARD
  SKILLING_CALCULATOR
  BOSSING_ENGINE
  PREMIUM_SERVICE_CONFIGURATOR
  GOLD_ENGINE
  ACCOUNT_MARKETPLACE
  CUSTOM_ACCOUNT_BUILD
  PRODUCT_MARKETPLACE
}

enum CataloguePublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CatalogueAvailabilityState {
  AVAILABLE
  PAUSED
  UNAVAILABLE
}

enum CatalogueGameMode {
  NORMAL
  IRONMAN
  HARDCORE_IRONMAN
  ULTIMATE_IRONMAN
}

enum CatalogueRequirementType {
  SKILL
  QUEST
  ITEM
  ACTIVITY
  ACCOUNT
  OTHER
}

enum RequirementVerificationMode {
  AUTOMATIC
  CUSTOMER_CONFIRMED
  SUPPORT_VERIFIED
}

enum CatalogueComparisonOperator {
  GREATER_THAN_OR_EQUAL
  GREATER_THAN
  EQUAL
  LESS_THAN_OR_EQUAL
  LESS_THAN
}

enum CatalogueRevisionEvent {
  PUBLISHED
  REPUBLISHED
  ARCHIVED
}

enum SkillingSkillKey {
  ATTACK
  STRENGTH
  DEFENCE
  RANGED
  PRAYER
  MAGIC
  RUNECRAFT
  CONSTRUCTION
  HITPOINTS
  AGILITY
  HERBLORE
  THIEVING
  CRAFTING
  FLETCHING
  SLAYER
  HUNTER
  MINING
  SMITHING
  FISHING
  COOKING
  FIREMAKING
  WOODCUTTING
  FARMING
}

enum SkillingDeliverySpeed {
  STANDARD
  PRIORITY
  EXPRESS
}

enum BossingPriceMode {
  PER_KILL
  FIXED_PACKAGE
}

enum PremiumOptionType {
  ADDON
  SUPPLIES
  GEAR_SUPPORT
  UNLOCK_SUPPORT
}

enum PremiumOptionPricingMode {
  FIXED_FEE
  PERCENT_OF_BASE
  PER_UNIT
}

enum PremiumConfiguratorType {
  FIRE_CAPE
  INFERNAL_CAPE
  COLOSSEUM
  YAMA
  ROYAL_TITANS
  CORRUPTED_GAUNTLET
  DOOM_OF_MOKHAIOTL
  RAIDS
  CUSTOM
}

enum PremiumRequirementType {
  SKILL
  QUEST
  ITEM
  ACTIVITY
  ACCOUNT
  GEAR
  UNLOCK
  OTHER
}

enum PricingRuleSetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PricingRuleType {
  FIXED_ADDITION
  PERCENTAGE_ADDITION
  MINIMUM_TOTAL
  MAXIMUM_TOTAL
}

enum PricingScope {
  GLOBAL
  ENGINE_TYPE
  CATEGORY
  SERVICE
}

enum GoldTradeDirection {
  CUSTOMER_BUYS_GOLD
  CUSTOMER_SELLS_GOLD
}

enum GoldRateSetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GoldInventoryEntryType {
  STOCK_INCREASE
  STOCK_DECREASE
  BUY_CAPACITY_INCREASE
  BUY_CAPACITY_DECREASE
  CORRECTION
}

enum GoldAvailabilityState {
  AVAILABLE
  LIMITED_AVAILABILITY
  MANUAL_REVIEW_REQUIRED
  PAUSED
  UNAVAILABLE
}

enum GoldSecureServicePricingMode {
  DISABLED
  FIXED_MINOR_UNITS
  BASIS_POINTS
}

enum AccountListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AccountListingAvailability {
  AVAILABLE
  HELD
  SOLD
  PAUSED
  UNAVAILABLE
}

enum AccountListingApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AccountStatType {
  SKILL
  COMBAT
  QUEST
  SUMMARY
  OTHER
}

enum AccountUnlockType {
  QUEST
  DIARY
  MINIGAME
  BOSS_ACCESS
  RAID
  PRAYER
  SPELLBOOK
  TRANSPORTATION
  UNTRADEABLE
  ACCOUNT_PROGRESSION
  OTHER
}

enum AccountHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CANCELLED
}

enum AccountHandoverReadiness {
  INTERNAL_REVIEW_REQUIRED
  READY_FOR_FUTURE_HANDOVER
  NEEDS_MANUAL_REVIEW
}

enum AccountImageType {
  COVER
  GALLERY
  STAT_OVERVIEW
  UNLOCK_OVERVIEW
}

model User {
  id                  String                     @id @default(cuid()) @db.VarChar(30)
  email               String                     @unique @db.VarChar(191)
  emailVerified       DateTime?
  name                String?                    @db.VarChar(120)
  image               String?                    @db.VarChar(500)
  passwordHash        String                     @db.VarChar(255)
  status              UserStatus                 @default(ACTIVE)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  roles               UserRole[]
  sessions            Session[]
  auditLogs           AuditLog[]                 @relation("AuditActor")
  servicesCreated     CatalogueService[]         @relation("CatalogueServiceCreatedBy")
  servicesUpdated     CatalogueService[]         @relation("CatalogueServiceUpdatedBy")
  catalogueRevisions  CatalogueRevision[]        @relation("CatalogueRevisionActor")
  catalogueStages     CatalogueServiceStage[]    @relation("CatalogueServiceStageUpdatedBy")
  pricingRuleSets     PricingRuleSet[]           @relation("PricingRuleSetPublishedBy")
  pricingRevisions    PricingRevision[]          @relation("PricingRevisionPublishedBy")
  goldRateSets        GoldRateSet[]              @relation("GoldRateSetPublishedBy")
  goldRateRevisions   GoldRateRevision[]         @relation("GoldRateRevisionPublishedBy")
  goldLedgerEntries   GoldInventoryLedgerEntry[] @relation("GoldInventoryLedgerActor")
  accountRevisions    AccountListingRevision[]   @relation("AccountListingRevisionPublishedBy")
  accountHolds        AccountListingHold[]       @relation("AccountListingHoldCreatedBy")
  accountHoldReleases AccountListingHold[]       @relation("AccountListingHoldReleasedBy")

  @@index([status])
}

model Role {
  id          String           @id @default(cuid()) @db.VarChar(30)
  key         String           @unique @db.VarChar(64)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid()) @db.VarChar(30)
  key         String           @unique @db.VarChar(100)
  description String           @db.VarChar(500)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.VarChar(30)
  roleId     String   @db.VarChar(30)
  assignedAt DateTime @default(now())
  assignedBy String?  @db.VarChar(30)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.VarChar(30)
  permissionId String     @db.VarChar(30)
  grantedAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id           String   @id @default(cuid()) @db.VarChar(30)
  sessionToken String   @unique @db.VarChar(191)
  userId       String   @db.VarChar(30)
  expires      DateTime
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  ipAddress    String?  @db.VarChar(64)
  userAgent    String?  @db.VarChar(500)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model FeatureFlag {
  id          String   @id @default(cuid()) @db.VarChar(30)
  key         String   @unique @db.VarChar(120)
  enabled     Boolean  @default(false)
  description String   @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(30)
  actorId    String?  @db.VarChar(30)
  action     String   @db.VarChar(120)
  targetType String?  @db.VarChar(120)
  targetId   String?  @db.VarChar(191)
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model CatalogueCategory {
  id               String                     @id @default(cuid()) @db.VarChar(30)
  name             String                     @db.VarChar(140)
  slug             String                     @unique @db.VarChar(160)
  shortDescription String                     @db.VarChar(500)
  description      String?                    @db.Text
  iconKey          String?                    @db.VarChar(80)
  imagePath        String?                    @db.VarChar(500)
  displayOrder     Int                        @default(0)
  isActive         Boolean                    @default(true)
  seoTitle         String?                    @db.VarChar(191)
  seoDescription   String?                    @db.VarChar(500)
  seededKey        String?                    @unique @db.VarChar(100)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  services         CatalogueService[]
  mediaReferences  CatalogueMediaReference[]
  pricingScopes    PricingRuleApplicability[]

  @@index([isActive, displayOrder])
}

model CatalogueService {
  id                                String                         @id @default(cuid()) @db.VarChar(30)
  categoryId                        String                         @db.VarChar(30)
  name                              String                         @db.VarChar(160)
  slug                              String                         @db.VarChar(180)
  canonicalSlug                     String                         @unique @db.VarChar(191)
  shortSummary                      String                         @db.VarChar(500)
  content                           String                         @db.Text
  serviceType                       CatalogueServiceType           @default(SERVICE)
  engineType                        CatalogueEngineType
  publicationStatus                 CataloguePublicationStatus     @default(DRAFT)
  availabilityState                 CatalogueAvailabilityState     @default(AVAILABLE)
  isFeatured                        Boolean                        @default(false)
  isQuoteOnly                       Boolean                        @default(true)
  displayOrder                      Int                            @default(0)
  internalNotes                     String?                        @db.Text
  publicPreparationNotes            String?                        @db.Text
  primaryMediaPath                  String?                        @db.VarChar(500)
  seoTitle                          String?                        @db.VarChar(191)
  seoDescription                    String?                        @db.VarChar(500)
  publishAt                         DateTime?
  unpublishAt                       DateTime?
  createdById                       String?                        @db.VarChar(30)
  updatedById                       String?                        @db.VarChar(30)
  version                           Int                            @default(1)
  legacySource                      Json?
  seededKey                         String?                        @unique @db.VarChar(100)
  needsClientReview                 Boolean                        @default(true)
  createdAt                         DateTime                       @default(now())
  updatedAt                         DateTime                       @updatedAt
  category                          CatalogueCategory              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy                         User?                          @relation("CatalogueServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                         User?                          @relation("CatalogueServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  gameModes                         CatalogueServiceGameMode[]
  requirements                      CatalogueRequirement[]
  mediaReferences                   CatalogueMediaReference[]
  revisions                         CatalogueRevision[]
  stage                             CatalogueServiceStage?
  offerings                         CatalogueOffering[]
  skillingSkills                    SkillingSkillConfig[]
  skillingRule                      SkillingCalculatorRule?
  recommendedByServiceRequirements  CatalogueRequirement[]         @relation("CatalogueRequirementRecommendation")
  recommendedByOfferingRequirements CatalogueOfferingRequirement[] @relation("CatalogueOfferingRequirementRecommendation")
  skillingTrainingMethods           SkillingTrainingMethod[]
  bossingRule                       BossingCalculatorRule?
  bossingBosses                     BossingBossConfig[]
  bossingMethods                    BossingMethod[]
  premiumConfig                     PremiumServiceConfig?
  premiumPackages                   PremiumPackage[]
  premiumOptions                    PremiumOption[]
  premiumRequirementGroups          PremiumRequirementGroup[]
  premiumFaqs                       PremiumFaq[]
  pricingScopes                     PricingRuleApplicability[]
  goldMarket                        GoldMarket?
  accountMarketplace                AccountMarketplace?

  @@unique([categoryId, slug])
  @@index([publicationStatus, publishAt, unpublishAt])
  @@index([categoryId, publicationStatus, displayOrder])
  @@index([availabilityState])
  @@index([engineType])
  @@index([isFeatured])
}

model CatalogueServiceStage {
  id          String           @id @default(cuid()) @db.VarChar(30)
  serviceId   String           @unique @db.VarChar(30)
  snapshot    Json
  baseVersion Int
  version     Int              @default(1)
  updatedById String?          @db.VarChar(30)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  service     CatalogueService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  updatedBy   User?            @relation("CatalogueServiceStageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById, updatedAt])
}

model CatalogueServiceGameMode {
  serviceId String            @db.VarChar(30)
  gameMode  CatalogueGameMode
  service   CatalogueService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([serviceId, gameMode])
  @@index([gameMode])
}

model CatalogueRequirement {
  id                   String                       @id @default(cuid()) @db.VarChar(30)
  serviceId            String                       @db.VarChar(30)
  title                String                       @db.VarChar(191)
  description          String                       @db.Text
  type                 CatalogueRequirementType
  isRequired           Boolean                      @default(true)
  displayOrder         Int                          @default(0)
  verificationMode     RequirementVerificationMode
  customerGuidance     String?                      @db.Text
  metricKey            String?                      @db.VarChar(120)
  comparisonOperator   CatalogueComparisonOperator?
  requiredValue        BigInt?
  recommendedServiceId String?                      @db.VarChar(30)
  seededKey            String?                      @unique @db.VarChar(120)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  service              CatalogueService             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  recommendedService   CatalogueService?            @relation("CatalogueRequirementRecommendation", fields: [recommendedServiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([serviceId, displayOrder])
  @@index([recommendedServiceId])
}

model CatalogueOffering {
  id                String                         @id @default(cuid()) @db.VarChar(30)
  serviceId         String                         @db.VarChar(30)
  seededKey         String?                        @unique @db.VarChar(140)
  slug              String                         @db.VarChar(180)
  name              String                         @db.VarChar(191)
  shortSummary      String                         @db.VarChar(500)
  description       String?                        @db.Text
  displayOrder      Int                            @default(0)
  isActive          Boolean                        @default(true)
  isFeatured        Boolean                        @default(false)
  needsClientReview Boolean                        @default(true)
  groupLabel        String?                        @db.VarChar(120)
  tierLabel         String?                        @db.VarChar(120)
  quantityEnabled   Boolean                        @default(false)
  quantityUnit      String?                        @db.VarChar(80)
  minimumQuantity   Int?
  maximumQuantity   Int?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  service           CatalogueService               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  facets            CatalogueOfferingFacet[]
  gameModes         CatalogueOfferingGameMode[]
  requirements      CatalogueOfferingRequirement[]

  @@unique([serviceId, slug])
  @@index([serviceId, isActive, displayOrder])
  @@index([serviceId, isFeatured])
  @@index([name])
}

model CatalogueOfferingFacet {
  id           String            @id @default(cuid()) @db.VarChar(30)
  offeringId   String            @db.VarChar(30)
  facetKey     String            @db.VarChar(80)
  facetValue   String            @db.VarChar(120)
  label        String            @db.VarChar(160)
  displayOrder Int               @default(0)
  offering     CatalogueOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, facetKey, facetValue])
  @@index([facetKey, facetValue])
  @@index([offeringId, displayOrder])
}

model CatalogueOfferingGameMode {
  offeringId String            @db.VarChar(30)
  gameMode   CatalogueGameMode
  offering   CatalogueOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@id([offeringId, gameMode])
  @@index([gameMode])
}

model CatalogueOfferingRequirement {
  id                   String                       @id @default(cuid()) @db.VarChar(30)
  offeringId           String                       @db.VarChar(30)
  title                String                       @db.VarChar(191)
  description          String                       @db.Text
  type                 CatalogueRequirementType
  isRequired           Boolean                      @default(true)
  displayOrder         Int                          @default(0)
  verificationMode     RequirementVerificationMode
  customerGuidance     String?                      @db.Text
  metricKey            String?                      @db.VarChar(120)
  comparisonOperator   CatalogueComparisonOperator?
  requiredValue        BigInt?
  recommendedServiceId String?                      @db.VarChar(30)
  seededKey            String?                      @unique @db.VarChar(160)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  offering             CatalogueOffering            @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  recommendedService   CatalogueService?            @relation("CatalogueOfferingRequirementRecommendation", fields: [recommendedServiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([offeringId, displayOrder])
  @@index([recommendedServiceId])
}

model RsnLookupCache {
  id        String   @id @default(cuid()) @db.VarChar(30)
  lookupKey String   @db.Char(64)
  provider  String   @db.VarChar(80)
  status    String   @db.VarChar(32)
  payload   Json?
  fetchedAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lookupKey, provider])
  @@index([expiresAt])
}

model PublicRateLimitBucket {
  id          String   @id @default(cuid()) @db.VarChar(30)
  identityKey String   @db.Char(64)
  actionKey   String   @db.VarChar(80)
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([identityKey, actionKey, windowStart])
  @@index([expiresAt])
}

model CatalogueMediaReference {
  id           String             @id @default(cuid()) @db.VarChar(30)
  categoryId   String?            @db.VarChar(30)
  serviceId    String?            @db.VarChar(30)
  assetPath    String             @db.VarChar(500)
  altText      String             @db.VarChar(300)
  caption      String?            @db.VarChar(500)
  displayOrder Int                @default(0)
  isPrimary    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  category     CatalogueCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  service      CatalogueService?  @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([categoryId, displayOrder])
  @@index([serviceId, displayOrder])
}

model CatalogueRevision {
  id                String                     @id @default(cuid()) @db.VarChar(30)
  serviceId         String                     @db.VarChar(30)
  revisionNumber    Int
  event             CatalogueRevisionEvent
  publicationStatus CataloguePublicationStatus
  summary           String                     @db.VarChar(500)
  snapshot          Json
  actorId           String?                    @db.VarChar(30)
  createdAt         DateTime                   @default(now())
  service           CatalogueService           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  actor             User?                      @relation("CatalogueRevisionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([serviceId, revisionNumber])
  @@index([serviceId, createdAt])
  @@index([actorId, createdAt])
}

model SkillingSkillConfig {
  id           String                   @id @default(cuid()) @db.VarChar(30)
  serviceId    String                   @db.VarChar(30)
  skillKey     SkillingSkillKey
  name         String                   @db.VarChar(80)
  enabled      Boolean                  @default(false)
  displayOrder Int                      @default(0)
  iconKey      String?                  @db.VarChar(80)
  seededKey    String?                  @unique @db.VarChar(140)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  service      CatalogueService         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  methods      SkillingTrainingMethod[]

  @@unique([serviceId, skillKey])
  @@index([serviceId, enabled, displayOrder])
}

model SkillingTrainingMethod {
  id                         String              @id @default(cuid()) @db.VarChar(30)
  serviceId                  String              @db.VarChar(30)
  skillConfigId              String              @db.VarChar(30)
  name                       String              @db.VarChar(160)
  slug                       String              @db.VarChar(180)
  shortDescription           String              @db.VarChar(500)
  enabled                    Boolean             @default(true)
  displayOrder               Int                 @default(0)
  minimumLevel               Int                 @default(1)
  maximumLevel               Int                 @default(99)
  xpPerHour                  Int?
  basePriceCentsPerMillionXp Int
  minimumPriceCents          Int                 @default(0)
  fixedFeeCents              Int                 @default(0)
  suppliesEnabled            Boolean             @default(false)
  suppliesLabel              String?             @db.VarChar(120)
  suppliesFeeCents           Int                 @default(0)
  notes                      String?             @db.Text
  needsClientReview          Boolean             @default(true)
  seededKey                  String?             @unique @db.VarChar(160)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  service                    CatalogueService    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  skillConfig                SkillingSkillConfig @relation(fields: [skillConfigId], references: [id], onDelete: Cascade)

  @@unique([skillConfigId, slug])
  @@index([serviceId, enabled, displayOrder])
  @@index([skillConfigId, enabled, displayOrder])
}

model SkillingCalculatorRule {
  id                            String           @id @default(cuid()) @db.VarChar(30)
  serviceId                     String           @unique @db.VarChar(30)
  normalModeMultiplierBps       Int              @default(0)
  ironmanMultiplierBps          Int              @default(1000)
  hardcoreIronmanMultiplierBps  Int              @default(2000)
  ultimateIronmanMultiplierBps  Int              @default(3000)
  discordStreamEnabled          Boolean          @default(true)
  discordStreamPercentBps       Int              @default(200)
  standardDeliveryEnabled       Boolean          @default(true)
  standardDeliveryLabel         String           @default("Standard") @db.VarChar(80)
  standardDeliveryDescription   String?          @db.VarChar(240)
  standardDeliveryEstimate      String?          @db.VarChar(120)
  standardDeliveryMultiplierBps Int              @default(0)
  standardDeliveryFixedFeeCents Int              @default(0)
  priorityDeliveryEnabled       Boolean          @default(false)
  priorityDeliveryLabel         String           @default("Priority") @db.VarChar(80)
  priorityDeliveryDescription   String?          @db.VarChar(240)
  priorityDeliveryEstimate      String?          @db.VarChar(120)
  priorityDeliveryMultiplierBps Int              @default(1500)
  priorityDeliveryFixedFeeCents Int              @default(0)
  expressDeliveryEnabled        Boolean          @default(false)
  expressDeliveryLabel          String           @default("Express") @db.VarChar(80)
  expressDeliveryDescription    String?          @db.VarChar(240)
  expressDeliveryEstimate       String?          @db.VarChar(120)
  expressDeliveryMultiplierBps  Int              @default(3000)
  expressDeliveryFixedFeeCents  Int              @default(0)
  needsClientReview             Boolean          @default(true)
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt
  service                       CatalogueService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model BossingCalculatorRule {
  id                            String           @id @default(cuid()) @db.VarChar(30)
  serviceId                     String           @unique @db.VarChar(30)
  normalModeMultiplierBps       Int              @default(0)
  ironmanMultiplierBps          Int              @default(1000)
  hardcoreIronmanMultiplierBps  Int              @default(2000)
  ultimateIronmanMultiplierBps  Int              @default(3000)
  discordStreamEnabled          Boolean          @default(true)
  discordStreamPercentBps       Int              @default(200)
  standardDeliveryEnabled       Boolean          @default(true)
  standardDeliveryLabel         String           @default("Standard") @db.VarChar(80)
  standardDeliveryDescription   String?          @db.VarChar(240)
  standardDeliveryEstimate      String?          @db.VarChar(120)
  standardDeliveryMultiplierBps Int              @default(0)
  standardDeliveryFixedFeeCents Int              @default(0)
  priorityDeliveryEnabled       Boolean          @default(false)
  priorityDeliveryLabel         String           @default("Priority") @db.VarChar(80)
