  createdAt             DateTime       @default(now())
  listing               AccountListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  publishedBy           User?          @relation("AccountListingRevisionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([listingId, revisionNumber])
  @@index([listingId, publishedAt])
  @@index([publishedById])
}

model AccountListingHold {
  id                   String                     @id @default(cuid()) @db.VarChar(30)
  stableKey            String                     @unique @db.VarChar(160)
  listingId            String                     @db.VarChar(30)
  status               AccountHoldStatus          @default(ACTIVE)
  previousAvailability AccountListingAvailability @default(AVAILABLE)
  startsAt             DateTime                   @default(now())
  expiresAt            DateTime
  reason               String                     @db.VarChar(240)
  createdById          String?                    @db.VarChar(30)
  releasedAt           DateTime?
  releasedById         String?                    @db.VarChar(30)
  concurrencyVersion   Int                        @default(1)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  listing              AccountListing             @relation(fields: [listingId], references: [id], onDelete: Restrict)
  createdBy            User?                      @relation("AccountListingHoldCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  releasedBy           User?                      @relation("AccountListingHoldReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([listingId, status, expiresAt])
  @@index([createdById, createdAt])
  @@index([releasedById, releasedAt])
}

model AccountListingHandoverChecklist {
  id                             String                   @id @default(cuid()) @db.VarChar(30)
  listingId                      String                   @unique @db.VarChar(30)
  listingSecurityReviewed        Boolean                  @default(false)
  emailTransferRequired          Boolean                  @default(true)
  recoveryReviewRequired         Boolean                  @default(true)
  authenticatorResetRequired     Boolean                  @default(true)
  bankPinResetRequired           Boolean                  @default(true)
  previousSessionsReviewRequired Boolean                  @default(true)
  handoverInstructionsPrepared   Boolean                  @default(false)
  ownershipEvidenceReviewed      Boolean                  @default(false)
  readyForFutureHandover         Boolean                  @default(false)
  finalAdminApprovalRequired     Boolean                  @default(true)
  readiness                      AccountHandoverReadiness @default(INTERNAL_REVIEW_REQUIRED)
  needsClientReview              Boolean                  @default(true)
  concurrencyVersion             Int                      @default(1)
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  listing                        AccountListing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model PricingRuleSet {
  id                    String               @id @default(cuid()) @db.VarChar(30)
  name                  String               @db.VarChar(160)
  description           String?              @db.VarChar(500)
  status                PricingRuleSetStatus @default(DRAFT)
  currencyCode          String               @default("USD") @db.Char(3)
  snapshotSchemaVersion Int                  @default(1)
  draftVersion          Int                  @default(1)
  publishedAt           DateTime?
  publishedById         String?              @db.VarChar(30)
  needsClientReview     Boolean              @default(true)
  internalNotes         String?              @db.Text
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  publishedBy           User?                @relation("PricingRuleSetPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  rules                 PricingRule[]
  revisions             PricingRevision[]

  @@index([status, updatedAt])
  @@index([publishedById])
}

model PricingRule {
  id                  String                     @id @default(cuid()) @db.VarChar(30)
  ruleSetId           String                     @db.VarChar(30)
  publicLabel         String                     @db.VarChar(160)
  internalDescription String?                    @db.Text
  enabled             Boolean                    @default(true)
  ruleType            PricingRuleType
  amountCents         Int?
  valueBps            Int?
  priority            Int                        @default(0)
  exclusiveGroupKey   String?                    @db.VarChar(120)
  effectiveStart      DateTime?
  effectiveEnd        DateTime?
  needsClientReview   Boolean                    @default(true)
  version             Int                        @default(1)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  ruleSet             PricingRuleSet             @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  applicability       PricingRuleApplicability[]

  @@index([ruleSetId, enabled, priority])
  @@index([ruleType])
  @@index([exclusiveGroupKey])
  @@index([effectiveStart, effectiveEnd])
}

model PricingRuleApplicability {
  id         String               @id @default(cuid()) @db.VarChar(30)
  ruleId     String               @db.VarChar(30)
  scope      PricingScope
  engineType CatalogueEngineType?
  categoryId String?              @db.VarChar(30)
  serviceId  String?              @db.VarChar(30)
  createdAt  DateTime             @default(now())
  rule       PricingRule          @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  category   CatalogueCategory?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  service    CatalogueService?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([scope, engineType])
  @@index([categoryId])
  @@index([serviceId])
}

model PricingRevision {
  id             String         @id @default(cuid()) @db.VarChar(30)
  ruleSetId      String         @db.VarChar(30)
  revisionNumber Int
  snapshot       Json
  publishedAt    DateTime       @default(now())
  publishedById  String?        @db.VarChar(30)
  createdAt      DateTime       @default(now())
  ruleSet        PricingRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  publishedBy    User?          @relation("PricingRevisionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([ruleSetId, revisionNumber])
  @@index([publishedAt])
  @@index([publishedById])
}
