  @@index([notificationType, status])
  @@index([nextAttemptAt])
}

model GoldInventoryReservation {
  id                  String                         @id @default(cuid()) @db.VarChar(30)
  stableKey           String                         @unique @db.VarChar(160)
  marketId            String                         @db.VarChar(30)
  quantityGp          BigInt
  status              GoldInventoryReservationStatus @default(ACTIVE)
  expiresAt           DateTime
  releasedAt          DateTime?
  consumedAt          DateTime?
  safeInternalPurpose String                         @db.VarChar(240)
  actorId             String?                        @db.VarChar(30)
  idempotencyKeyHash  String?                        @unique @db.Char(64)
  futureExternalRef   String?                        @db.VarChar(160)
  concurrencyVersion  Int                            @default(1)
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  market              GoldMarket                     @relation(fields: [marketId], references: [id], onDelete: Restrict)
  actor               User?                          @relation("GoldReservationActor", fields: [actorId], references: [id], onDelete: SetNull)
  orderAllocations    OrderResourceAllocation[]

  @@index([marketId, status, expiresAt])
  @@index([actorId, createdAt])
  @@index([futureExternalRef])
}
